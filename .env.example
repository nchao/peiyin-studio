# ---- 小米 MiMo TTS ----
# 控制台 https://mimo.mi.com 用小米账号登录后创建，形如 sk-xxxxx
MIMO_API_KEY=sk-your-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts

# ---- LLM 预处理（OpenAI 兼容格式）----
# 默认复用 MiMo 的同一个 key 和地址；换别的服务改这三项即可
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=mimo-v2.5-pro

# ---- 运行参数 ----
# 并发合成段数。TTS 限流 RPM 100 且按账号聚合，别调太高
TTS_CONCURRENCY=4
# 单次 TTS 请求最大字符数，超长的段会被强制再切
TTS_MAX_CHARS=300
# 429 / 5xx 的最大重试次数
TTS_MAX_RETRY=3
# 对外端口（改这里同时要改 docker-compose.yml 的映射）
PORT=8756

# 访问密码：留空=不鉴权（本地/局域网直接用）；设值=打开页面需输此密码。
# 用于对外域名场景。务必同时让域名走 HTTPS，否则密码在公网明文传输。
APP_PASSWORD=

# ---- 预处理分块 ----
# 每块送 LLM 的字符数。LLM 输出有 token 上限（实测 1700 字会被 4096 token
# 截断），必须切块。调大能少几次请求，但太大会撞上限
LLM_CHUNK_CHARS=400
# 并行处理几块
LLM_CONCURRENCY=4
# 关闭模型的推理模式。分段是结构化任务，开推理会慢 30 倍（96s vs 3s）且
# 保真率更差。只有换成不支持该参数的模型时才需要设为 false
LLM_DISABLE_THINKING=true
