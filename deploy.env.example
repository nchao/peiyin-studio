# deploy.sh 的部署目标配置。复制本文件为 deploy.env 并填入真实值。
# deploy.env 不进 git（见 .gitignore）。

# NAS 的 SSH 登录地址：用户名@主机（局域网 IP 或 Tailscale 地址）
NAS_HOST="user@your-nas-host"
# SSH 端口
NAS_PORT="22"
# NAS 上放本项目的目录
NAS_DIR="/volume1/docker/peiyin"

# 镜像 tag，一般不用改
IMAGE="peiyin:latest"
# NAS 上 docker 的绝对路径（sudoers 免密白名单按此匹配）
DOCKER="/usr/local/bin/docker"
# 本地构建拉基础镜像用的代理；能直连官方镜像源则留空
PROXY=""
